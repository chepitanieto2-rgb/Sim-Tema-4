<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.nietosystems.simulacion.controller.MainController"
        prefWidth="800.0"
        prefHeight="550.0"
        style="-fx-background-color: #F4F6F8;">

    <!-- ENCABEZADO -->
    <top>

        <VBox
                alignment="CENTER"
                spacing="8"
                style="-fx-background-color: #1F4E78;">

            <padding>
                <Insets
                        top="30"
                        right="20"
                        bottom="30"
                        left="20"/>
            </padding>

            <Label
                    text="SISTEMA DE SIMULACIÓN"
                    style="-fx-text-fill: white;
                           -fx-font-size: 28px;
                           -fx-font-weight: bold;"/>

            <Label
                    text="Programa de simulaciones"
                    style="-fx-text-fill: #D9EAF7;
                           -fx-font-size: 15px;"/>

        </VBox>

    </top>


    <!-- CONTENIDO PRINCIPAL -->
    <center>

        <VBox
                alignment="CENTER"
                spacing="20">

            <padding>
                <Insets
                        top="40"
                        right="60"
                        bottom="40"
                        left="60"/>
            </padding>


            <Label
                    text="Seleccione una simulación"
                    style="-fx-text-fill: #333333;
                           -fx-font-size: 20px;
                           -fx-font-weight: bold;"/>


            <Button
                    text="SIMULACIÓN DE ESPERA"
                    prefWidth="350"
                    prefHeight="60"
                    onAction="#abrirEspera"
                    style="-fx-background-color: #2E75B6;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;"/>


            <Button
                    text="SIMULACIÓN DE INVENTARIO"
                    prefWidth="350"
                    prefHeight="60"
                    onAction="#abrirInventario"
                    style="-fx-background-color: #548235;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;"/>

        </VBox>

    </center>


    <!-- PIE DE VENTANA -->
    <bottom>

        <VBox
                alignment="CENTER"
                style="-fx-background-color: #D9E1F2;">

            <padding>
                <Insets
                        top="15"
                        right="15"
                        bottom="15"
                        left="15"/>
            </padding>

            <Button
                    text="SALIR"
                    prefWidth="150"
                    prefHeight="40"
                    onAction="#salir"
                    style="-fx-background-color: #C00000;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;"/>

        </VBox>

    </bottom>

</BorderPane>
